# Local: copy this file to .env and keep the gateway disabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
VITE_USE_PAIRING_GATEWAY=false
VITE_TELEMETRY_ENDPOINT=

# Vercel only. Never add the secret key to a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key
RATE_LIMIT_SALT=your-random-secret
CRON_SECRET=your-random-secret

# On Vercel use:
# VITE_USE_PAIRING_GATEWAY=true
# VITE_TELEMETRY_ENDPOINT=/api/telemetry
