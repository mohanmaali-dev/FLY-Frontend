# Supabase project credentials.
# Dashboard -> Project Settings -> API. The anon/publishable key is browser-safe;
# row level security is what protects the data. Never put the service_role key
# in this file — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# There is no email-confirmation step. Registration signs the user straight in,
# which requires "Confirm email" to be OFF in the Supabase dashboard
# (Authentication -> Sign In / Providers -> Email).
